{
  "sentences": [
    {
      "sentence": 1,
      "start": 0.0,
      "end": 4.008,
      "duration": 4.008,
      "words": 6,
      "text": "Tsutomu Yamaguchi was a Japanese engineer."
    },
    {
      "sentence": 2,
      "start": 4.508,
      "end": 12.668,
      "duration": 8.16,
      "words": 18,
      "text": "On August 6, 1945, he was on a business trip in Hiroshima, when the first atomic bomb fell."
    },
    {
      "sentence": 3,
      "start": 13.168,
      "end": 16.696,
      "duration": 3.528,
      "words": 7,
      "text": "Burned and injured, he survived the night."
    },
    {
      "sentence": 4,
      "start": 17.196,
      "end": 22.74,
      "duration": 5.544,
      "words": 12,
      "text": "The next morning, bandaged, he took a train home — to Nagasaki."
    },
    {
      "sentence": 5,
      "start": 23.24,
      "end": 29.984,
      "duration": 6.744,
      "words": 18,
      "text": "On August 9, at work, he was telling his boss about the horror he had seen in Hiroshima."
    },
    {
      "sentence": 6,
      "start": 30.484,
      "end": 35.596,
      "duration": 5.112,
      "words": 10,
      "text": "At that moment, the second atomic bomb exploded over Nagasaki."
    },
    {
      "sentence": 7,
      "start": 36.096,
      "end": 39.912,
      "duration": 3.816,
      "words": 4,
      "text": "Incredibly, Yamaguchi survived again."
    },
    {
      "sentence": 8,
      "start": 40.412,
      "end": 48.02,
      "duration": 7.608,
      "words": 19,
      "text": "He lived to the age of 93 — the only person officially recognized to have survived both atomic bombings."
    }
  ],
