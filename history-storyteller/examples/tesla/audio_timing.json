   "asr_first": "It",
   "word_start": 10.54,
   "speech_end": 13.9,
   "onset": 10.61,
   "start": 10.55,
   "end": 14.41
  },
  {
   "sentence": 4,
   "text": "But in December 1901, Marconi sent a radio signal across the Atlantic, using far cheaper equipment.",
   "first_word": "But",
   "asr_first": "But",
   "word_start": 14.42,
   "speech_end": 19.76,
   "onset": 14.47,
   "start": 14.41,
   "end": 20.21
  },
  {
   "sentence": 5,
   "text": "Tesla then asked Morgan for more money. His real dream was sending power through the air.",
   "first_word": "Tesla",
   "asr_first": "Tesla",
   "word_start": 20.24,
   "speech_end": 24.6,
   "onset": 20.27,
   "start": 20.21,
   "end": 24.88
  },
  {
   "sentence": 6,
   "text": "Morgan refused to give him another cent.",
   "first_word": "Morgan",
   "asr_first": "Morgan",
   "word_start": 24.88,
   "speech_end": 26.88,
   "onset": 24.94,
   "start": 24.88,
   "end": 27.22
  },
  {
   "sentence": 7,
   "text": "Tesla begged other investors for help, but no one would pay.",
