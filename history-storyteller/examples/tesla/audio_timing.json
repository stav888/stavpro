{
 "rows": [
  {
   "sentence": 1,
   "text": "In 1901, Nikola Tesla began building a giant tower on Long Island, New York.",
   "first_word": "In",
   "asr_first": "In",
   "word_start": 0.0,
   "speech_end": 5.14,
   "start": 0.0,
   "onset": 0.26,
   "end": 5.56
  },
  {
   "sentence": 2,
   "text": "His dream was to send messages, and even electricity, through the air to the whole world.",
   "first_word": "His",
   "asr_first": "His",
