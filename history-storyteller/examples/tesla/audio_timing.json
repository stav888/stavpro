   "asr_first": "Tesla",
   "word_start": 26.88,
   "speech_end": 30.18,
   "onset": 27.28,
   "start": 27.22,
   "end": 30.63
  },
  {
   "sentence": 8,
   "text": "By 1906, work on the tower stopped, and Tesla's hotel bills kept growing.",
