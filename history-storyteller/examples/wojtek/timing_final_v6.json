{
  "sentences": [
    {
      "sentence": 1,
      "start": 0.2,
      "end": 5.225,
      "words": 12,
      "text": "In Iran in 1942, Polish soldiers found an orphaned brown bear cub.",
      "duration": 5.025,
      "lock_end": 5.225
    },
    {
      "sentence": 2,
      "start": 5.225,
      "end": 9.3,
      "words": 12,
      "text": "They adopted him, named him Wojtek, and raised him in their unit.",
      "duration": 4.075,
      "lock_end": 9.3
    },
    {
      "sentence": 3,
      "start": 9.3,
      "end": 13.3,
      "words": 12,
      "text": "He ate, slept, and marched with the men, part of the company.",
      "duration": 4.0,
      "lock_end": 13.3
    },
    {
      "sentence": 4,
      "start": 13.3,
      "end": 17.8,
      "words": 14,
      "text": "To sail with them to Italy, the army officially enlisted him as a soldier.",
      "duration": 4.5,
      "lock_end": 17.8
    },
    {
      "sentence": 5,
      "start": 17.8,
      "end": 22.7,
      "words": 13,
      "text": "Private Wojtek got a service number, a pay book, and later became corporal.",
      "duration": 4.9,
      "lock_end": 22.7
    },
    {
      "sentence": 6,
      "start": 22.7,
      "end": 28.65,
      "words": 13,
      "text": "At Monte Cassino in 1944, soldiers said he carried crates of artillery shells.",
      "duration": 5.95,
      "lock_end": 28.65
    },
    {
      "sentence": 7,
      "start": 28.65,
      "end": 33.525,
      "words": 12,
      "text": "After the war, he lived at Edinburgh Zoo, visited by old comrades.",
      "duration": 4.875,
      "lock_end": 33.525
    },
    {
      "sentence": 8,
      "start": 33.525,
      "end": 38.243,
      "words": 14,
      "text": "He died in 1963 — more than a mascot, he was one of them.",
      "duration": 4.718,
      "lock_end": 38.243
    }
  ],
